---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Main from '../../layouts/Main.astro';
import { SITE } from '../../consts';

const notes = (await getCollection('notes')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={`${SITE.title} | 笔记`} description="收录工作过程中的阶段性笔记与研究材料。" />
  </head>
  <body>
    <Header />
    <Main props={{ pageTitle: '笔记', pageDesc: '整理阶段性研究材料、工作笔记与尚未扩展为正式文章的内容。' }}>
      <ul>
        {notes.map(entry => <PostCard entry={entry} href={`/notes/${entry.id}/`} variant="h2" />)}
      </ul>
    </Main>
    <Footer />
  </body>
</html>
