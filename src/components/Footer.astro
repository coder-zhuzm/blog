---
import Hr from './Hr.astro';
import Socials from './Socials.astro';
---

<footer class="w-full mt-auto">
  <Hr noPadding />
  <div class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4">
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap text-sm opacity-80 sm:flex-row">
      <span>© {new Date().getFullYear()} zhuzm</span>
    </div>
  </div>
</footer>
