---
import { SITE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Hr from './Hr.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute left-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    跳转到正文
  </a>
  <div class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row">
    <div class="relative flex w-full items-baseline justify-between bg-background py-4 sm:items-center sm:py-6">
      <a href="/" class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none">
        {SITE.title}
      </a>
      <nav class="flex items-center gap-5 text-sm sm:text-base">
        {SITE.navLinks.map(item => (
          <HeaderLink href={item.href} class="font-medium hover:text-accent">
            {item.label}
          </HeaderLink>
        ))}
        {SITE.lightAndDarkMode && <ThemeToggle />}
      </nav>
    </div>
  </div>
  <Hr />
</header>
